{
  "mcpServers": {
    "ido-dev": {
      "command": "cargo",
      "args": [
        "run",
        "-q",
        "-p",
        "ido-mcp",
        "--features",
        "semantic",
        "--",
        "--well",
        "dev-well",
        "--allow-write"
      ],
      "env": { "CARGO_TARGET_DIR": "target/mcp-dev" }
    },
    "ido-docs": {
      "command": "cargo",
      "args": [
        "run",
        "-q",
        "-p",
        "ido-mcp",
        "--features",
        "semantic",
        "--",
        "--well",
        "/absolute/path/to/your/docs/well"
      ],
      "env": { "CARGO_TARGET_DIR": "target/mcp-dev" }
    }
  }
}
